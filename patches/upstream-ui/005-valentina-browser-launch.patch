+// valentinaOpenBrowser checks this profile's authenticated CRM, not just an open
+// port. Redirects and environment proxies are forbidden. Tokens never enter URLs.
+func valentinaOpenBrowser(port int) error {
+	if port < 1 || port > 65535 {
+		return fmt.Errorf("invalid local port")
+	}
+	home, err := huginnDir()
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	return valentinaWaitAndOpen(ctx, port, home, traypkg.OpenURL)
+}
+
+func valentinaWaitAndOpen(ctx context.Context, port int, home string, open func(string) error) error {
+	if port < 1 || port > 65535 {
+		return fmt.Errorf("invalid local port")
+	}
+	address := fmt.Sprintf("http://127.0.0.1:%d", port)
+	transport := &http.Transport{Proxy: nil}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	for ctx.Err() == nil {
+		token, readErr := os.ReadFile(filepath.Join(home, "server.token"))
+		if readErr == nil && len(bytes.TrimSpace(token)) > 0 {
+			req, _ := http.NewRequestWithContext(ctx, http.MethodGet, address+"/api/v1/valentina/licenses", nil)
+			req.Header.Set("Authorization", "Bearer "+strings.TrimSpace(string(token)))
+			response, requestErr := client.Do(req)
+			if requestErr == nil {
+				var result struct {
+					Commit string `json:"upstream_commit"`
+				}
+				decodeErr := json.NewDecoder(io.LimitReader(response.Body, 32768)).Decode(&result)
+				response.Body.Close()
+				if response.StatusCode == http.StatusOK && decodeErr == nil && result.Commit == "f01c1d84c08b1de972d8cc268da25602598adff8" {
+					return open(address)
+				}
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(200 * time.Millisecond):
+		}
+	}
+	return ctx.Err()
+}
