--- a/main.go
+++ b/main.go
@@ -55,6 +55,8 @@ import (
 	"github.com/scrypster/huginn/internal/skills"
 	"github.com/scrypster/huginn/internal/spaces"
 	"github.com/scrypster/huginn/internal/sqlitedb"
+	valentinaapi "github.com/scrypster/huginn/internal/valentina/api"
+	"github.com/scrypster/huginn/internal/valentina/domain"
 	"github.com/scrypster/huginn/internal/stats"
 	"github.com/scrypster/huginn/internal/storage"
 	"github.com/scrypster/huginn/internal/symbol"
@@ -3759,7 +3761,31 @@ func startServer(cfg *config.Config) (srv *server.Server, token string, cleanup
 	srv.SetVersion(version)
 
 	ctx := context.Background()
+	var valentinaStore *domain.Store
+
+	// VALENTINA CRM initialization
+	// Create the domain Store and API before server start so CRM routes
+	// are registered during registerRoutes(). Keep the DB in the user data dir.
+	if sqlDB != nil {
+		valentinaDir := filepath.Join(huginnHome, "valentina")
+		if err := os.MkdirAll(valentinaDir, 0700); err != nil {
+			return nil, "", nil, fmt.Errorf("valentina dir: %w", err)
+		}
+		valentinaDBPath := filepath.Join(valentinaDir, "valentina.db")
+		store, err := domain.NewStore(ctx, valentinaDBPath)
+		if err != nil {
+			return nil, "", nil, fmt.Errorf("valentina store: %w", err)
+		}
+		valentinaStore = store
+		crmAPI := valentinaapi.NewServer(valentinaStore)
+		srv.SetValentinaAPI(crmAPI)
+		cleanupFns = append(cleanupFns, func() { _ = valentinaStore.Close() })
+	}
+
 	if err := srv.Start(ctx); err != nil {
+		if valentinaStore != nil {
+			_ = valentinaStore.Close()
+		}
 		return nil, "", nil, fmt.Errorf("server start: %w", err)
 	}
 	orch.StartSessionCleanup(ctx)
