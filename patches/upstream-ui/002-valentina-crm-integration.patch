@@ -290,6 +292,25 @@ func (s *Server) SetMCPManager(mgr *mcp.ServerManager) {
 	s.mcpMgr = mgr
 }
 
+// SetValentinaAPI wires the VALENTINA CRM API into the existing Huginn HTTP server.
+func (s *Server) SetValentinaAPI(a *api.Server) {
+	s.valentinaAPI = a
+}
+
+// apiMiddleware wraps a handler with the same logging, request-ID, auth, and
+// body-limit middleware used by all authenticated Huginn API endpoints.
+func (s *Server) apiMiddleware(h http.HandlerFunc) http.HandlerFunc {
+	return loggingMiddleware(requestIDMiddleware(s.authMiddleware(func(w http.ResponseWriter, r *http.Request) {
+		r.Body = http.MaxBytesReader(w, r.Body, 10<<20) // 10 MiB
+		h(w, r)
+	})))
+}
+
+// registerValentinaRoutes mounts the VALENTINA CRM API routes on the mux.
+func (s *Server) registerValentinaRoutes(mux *http.ServeMux) {
+	if s.valentinaAPI == nil {
+		return
+	}
+	for pattern, handler := range s.valentinaAPI.Routes() {
+		mux.HandleFunc(pattern, s.apiMiddleware(handler))
+	}
+}
+
 // registerRoutes registers all HTTP routes on the mux.
 func (s *Server) registerRoutes(mux *http.ServeMux) {
 	// withMaxBody applies a per-endpoint body size limit. Applied before the
@@ -410,6 +431,9 @@ func (s *Server) registerRoutes(mux *http.ServeMux) {
 		mux.HandleFunc("GET /ws", s.handleWebSocket)
 
 		// Frontend SPA -- catch-all (must be last)
+		// VALENTINA CRM API routes (authenticated, logged, rate-limited)
+		s.registerValentinaRoutes(mux)
+
 		mux.Handle("/", http.FileServer(staticFS()))
 	}
 }
diff --git a/main.go b/main.go
--- a/main.go
+++ b/main.go
@@ -68,6 +68,8 @@ import (
 	"github.com/scrypster/huginn/internal/tools"
 	traypkg "github.com/scrypster/huginn/internal/tray"
 	"github.com/scrypster/huginn/internal/tui"
+	"github.com/scrypster/huginn/internal/valentina/internal/api"
+	"github.com/scrypster/huginn/internal/valentina/internal/domain"
 	"github.com/scrypster/huginn/internal/turnmetrics"
 	"github.com/scrypster/huginn/internal/workspace"
 )
@@ -4105,6 +4107,28 @@ func main() {
         srv, token, cleanup, err := startServer(cfg)
         if err != nil {
                 fatalf("%v", err)
         }
         defer cleanup()
 
+        // VALENTINA CRM: initialize domain store and API server inside the
+        // existing Huginn server process. User data lives outside the
+        // executable install directory, under ~/.huginn/valentina/.
+        huginnHome, hErr := huginnDir()
+        if hErr != nil {
+                fatalf("huginn dir: %v", hErr)
+        }
+        valentinaDir := filepath.Join(huginnHome, "valentina")
+        if mErr := os.MkdirAll(valentinaDir, 0755); mErr != nil {
+                fatalf("valentina dir: %v", mErr)
+        }
+        valentinaDBPath := filepath.Join(valentinaDir, "valentina.db")
+        valentinaStore, dErr := domain.NewStore(context.Background(), valentinaDBPath)
+        if dErr != nil {
+                fatalf("valentina store: %v", dErr)
+        }
+        defer valentinaStore.Close()
+
+        crmAPI := api.NewServer(valentinaStore)
+        srv.SetValentinaAPI(crmAPI)
+
         fmt.Printf("Huginn Web UI: http://%s\n", srv.Addr())
         fmt.Printf("Auth token:    %s\n", token)

