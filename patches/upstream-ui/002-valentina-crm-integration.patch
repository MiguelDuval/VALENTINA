@@ -155,6 +156,9 @@ type Server struct {
 	// label never renders blank, even on a plain `go build` without -ldflags.
 	version string
 
+	// valentinaAPI is the VALENTINA CRM API handler
+	valentinaAPI *valentinaapi.Server
+
 	// vaultProberFn probes MCP vault connectivity for handleVaultTest.
 	// When nil the production implementation (agent.ProbeVaultConnectivity) is used.
 	// Tests override this to avoid real network connections.
@@ -976,6 +980,13 @@ func (s *Server) SetVersion(v string) {
 	s.mu.Lock()
 	defer s.mu.Unlock()
 	s.version = v
 }
 
+// SetValentinaAPI wires the VALENTINA CRM API handler.
+func (s *Server) SetValentinaAPI(handler *valentinaapi.Server) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.valentinaAPI = handler
+}
+
 // SetMuninnConfigPath sets the path to the muninn.json global config.
@@ -1439,6 +1450,13 @@ func (s *Server) registerRoutes(mux *http.ServeMux) {
 	// WebSocket
 	mux.HandleFunc("GET /ws", s.handleWebSocket)
 
+	// VALENTINA CRM API routes
+	if s.valentinaAPI != nil {
+		for pattern, handler := range s.valentinaAPI.Routes() {
+			mux.HandleFunc(pattern, api(handler))
+		}
+	}
+
 	// Frontend SPA -- catch-all (must be last)
 	mux.Handle("/", http.FileServer(staticFS()))
 }
