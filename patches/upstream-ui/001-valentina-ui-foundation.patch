+<script setup lang="ts">
+import { computed, onMounted, ref } from 'vue'
+import { RouterLink } from 'vue-router'
+import { api } from '../composables/useApi'
+import { useAgents } from '../composables/useAgents'
+import { useWorkflows } from '../composables/useWorkflows'
+import { useNotifications } from '../composables/useNotifications'
+const { agents, fetchAgents } = useAgents()
+const { workflows, fetchWorkflows } = useWorkflows()
+const { pendingCount, fetchSummary } = useNotifications()
+const loading = ref(true)
+const health = ref<{ status: string; version?: string } | null>(null)
+const loadError = ref('')
+const lastUpdated = ref<Date | null>(null)
+const serverOnline = computed(() => health.value?.status === 'ok')
+const serverStatusLabel = computed(() => serverOnline.value ? 'Работает' : 'Нет связи')
+const enabledWorkflowCount = computed(() => workflows.value.filter(w => w.enabled).length)
+const metricCards = computed(() => [
+ { title: 'AI-агенты', value: agents.value.length, caption: 'настроено', to: '/agents', link: 'Управление', icon: '◈', tone: 'text-valentina-blue' },
+ { title: 'Активные процессы', value: enabledWorkflowCount.value, caption: 'включено', to: '/workflows', link: 'Открыть', icon: '⌘', tone: 'text-valentina-violet' },
+ { title: 'Требуют внимания', value: pendingCount.value, caption: 'уведомлений', to: '/inbox', link: 'Проверить', icon: '◷', tone: 'text-valentina-amber' },
+])
+const quickLinks = [
+ { title: 'Модели и NVIDIA NIM', description: 'Провайдер, модель и защищённый API-ключ', to: '/models', icon: '✧', tone: 'text-valentina-blue' },
+ { title: 'AI-агенты', description: 'Роли исследователя, проверяющего и оценщика', to: '/agents', icon: '◉', tone: 'text-valentina-violet' },
