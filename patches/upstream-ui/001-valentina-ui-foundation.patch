+ { title: 'Исследовательские процессы', description: 'Запуск, история, шаги и результаты', to: '/workflows', icon: '▦', tone: 'text-valentina-amber' },
+]
+const lastUpdatedLabel = computed(() => lastUpdated.value ? lastUpdated.value.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) : 'Ещё не проверялось')
+async function refreshDashboard() {
+ loading.value = true
+ loadError.value = ''
+ try {
+  const [healthResult] = await Promise.all([api.health(), fetchAgents(), fetchWorkflows(), fetchSummary()])
+  health.value = healthResult
+ } catch {
+  health.value = null
+  loadError.value = 'Не удалось получить состояние локального сервера. Проверьте подключение и повторите попытку.'
+ } finally {
+  lastUpdated.value = new Date()
+  loading.value = false
+ }
+}
+onMounted(refreshDashboard)
+</script>
