{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MiguelDuval/VALENTINA/blob/main/schemas/company.schema.json",
  "title": "VALENTINA Company v0.1",
  "description": "Provisional public-organization record. Does not contain personal contact data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "name", "normalized_name", "first_seen_at", "last_seen_at", "source_evidence_ids"],
  "properties": {
    "company_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 300 },
    "normalized_name": { "type": "string", "minLength": 1, "maxLength": 300 },
    "website": { "type": ["string", "null"], "format": "uri" },
    "domain": { "type": ["string", "null"], "maxLength": 253 },
    "industry_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "municipality": { "type": ["string", "null"] },
        "province": { "type": ["string", "null"] },
        "autonomous_community": { "type": ["string", "null"] },
        "country_code": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
      }
    },
    "source_evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "first_seen_at": { "type": "string", "format": "date-time" },
    "last_seen_at": { "type": "string", "format": "date-time" },
    "notes": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
